{
  "name": "bucket-together",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run type-check && npm test && npm run build",
    "db:migrate": "node scripts/database.mjs",
    "config:check": "node scripts/check-config.mjs"
  },
  "dependencies": {
    "next": "^16.4.2",
    "next-auth": "^4.24.15",
    "postgres": "^3.4.9",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.4.2",
    "typescript": "^5.0.0",
    "vitest": "^4.1.10"
  }
}
