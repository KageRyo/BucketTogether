# Local development. Production MUST use supabase and verified TLS.
DATA_BACKEND=local
# LOCAL_DATA_FILE=.data/bucket-together.json
# Supabase transaction pooler (port 6543); keep this server-only.
DATABASE_URL=
# Local disposable PostgreSQL only. Never use disable in production.
# DATABASE_SSL=disable
# TEST_DATABASE_URL=postgres://postgres:bucket_test@127.0.0.1:55439/bucket_test
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-secret

# Callback: https://YOUR_DOMAIN/api/auth/callback/line
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
# Callback: https://YOUR_DOMAIN/api/auth/callback/discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Callback: https://YOUR_DOMAIN/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Required for production privacy/contact information. These values are public.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_DATA_REGION=
NEXT_PUBLIC_BACKUP_RETENTION_DAYS=
