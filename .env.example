# 本地資料後端（目前支援 local）
DATA_BACKEND=local
# LOCAL_DATA_FILE=.data/bucket-together.json

# NextAuth
NEXTAUTH_URL=http://localhost:3000
# 本地可使用任意長隨機字串；正式環境必須設定強密鑰
NEXTAUTH_SECRET=replace-with-a-long-random-secret

# LINE Login（選用；兩者都存在時才會啟用 LINE 按鈕）
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=

# Supabase（保留給未來 production adapter，本地 MVP 不使用）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
